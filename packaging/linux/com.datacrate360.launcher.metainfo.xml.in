<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.datacrate360.launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>DataCrate360 Launcher</name>
  <summary>Install, update and launch the DataCrate360 tools</summary>
  <developer id="com.datacrate360">
    <name>DataCrate360</name>
  </developer>
  <description>
    <p>
      DataCrate360 Launcher lists every one of the DataCrate360 tools (such as omni-agent), installs
      the right build for your computer, and keeps them up to date.
    </p>
    <ul>
      <li>One place to find, install and open every DataCrate360 tool</li>
      <li>Checks GitHub releases for updates and installs them for you</li>
      <li>Lives in the system tray and tells you when updates are ready</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.datacrate360.launcher.desktop</launchable>
  <icon type="stock">com.datacrate360.launcher</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://datacrate360.com</url>
  <url type="bugtracker">https://github.com/datacrate360/datacrate360-launcher/issues</url>
  <url type="help">https://github.com/datacrate360/datacrate360-launcher</url>
  <categories>
    <category>Utility</category>
    <category>PackageManager</category>
  </categories>
  <keywords>
    <keyword>launcher</keyword>
    <keyword>installer</keyword>
    <keyword>updater</keyword>
    <keyword>datacrate360</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#eef5f3</color>
    <color type="primary" scheme_preference="dark">#0e1a1a</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>datacrate360-launcher</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
