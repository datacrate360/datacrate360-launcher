<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides for the setup wizard's WixUI strings, so its pages name the version being installed
  ([DataCrate360LauncherVersion] is the full version, pre-release tag included, set in
  datacrate360-launcher.wxs) and say what the launcher is for.
-->
<WixLocalization Culture="en-US" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="WelcomeDlgTitle" Value="{\WixUI_Font_Bigger}Welcome to [ProductName] [DataCrate360LauncherVersion]" />
  <String Id="WelcomeDlgDescription" Value="DataCrate360 Launcher installs, updates and opens the DataCrate360 tools, such as omni-agent.&#13;&#10;&#13;&#10;It installs for you only, so no administrator rights are needed. Click Next to continue." />
  <!-- The folder page (DataCrate360InstallDirDlg). -->
  <String Id="InstallDirDlgTitle" Value="{\WixUI_Font_Title}Choose where to install" />
  <String Id="InstallDirDlgDescription" Value="Click Next to install to the default folder, or click Change to pick another." />
  <String Id="DataCrate360InstallDirNote" Value="DataCrate360 Launcher installs for you only, without administrator rights, so pick a folder you can write to (not Program Files). Updates install into the same folder." />
  <String Id="DataCrate360DesktopShortcut" Value="Create a desktop shortcut" />
  <String Id="VerifyReadyDlgInstallTitle" Value="{\WixUI_Font_Title}Ready to install [ProductName] [DataCrate360LauncherVersion]" />
  <!-- Also shown after a repair or removal from the same wizard, so it doesn't say "installed". -->
  <String Id="ExitDialogTitle" Value="{\WixUI_Font_Bigger}Completed the [ProductName] [DataCrate360LauncherVersion] Setup Wizard" />
</WixLocalization>
